/* ── Container ── */
#container {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    background-color: rgba(18, 18, 18, 0.95);
    border-radius: 4px;
    padding: 8px;
    min-width: 150px;
}

#actionList {
    flex-direction: column;
}

/* ── Action Item ── */
.action-item {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    height: 26px;
    padding-left: 4px;
    padding-right: 4px;
    margin-bottom: 2px;
}

/* ── Selection Arrow ── */
.selection-arrow {
    width: 16px;
    height: 16px;
    margin-right: 6px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* ── Label ── */
.action-label {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
    color: rgba(255, 255, 255, 0.7);
    font-size: 14px;
    white-space: nowrap;
}